# DocuPilot AI environment variables
# Copy to .env (gitignored) and fill in server-side credentials.
# NEVER put a real key in this example file, the frontend, or git.

# ---------------------------------------------------------------------------
# Open model through the hackathon-provided Alan model gateway
# ---------------------------------------------------------------------------
# Verified for this hackathon account: OpenAI-compatible base URL below.
ALAN_MODEL_BASE_URL=https://api.tryalan.ai/public/harness/v1
# Server-side bearer token. Leave blank to run bundled samples in fixture mode.
ALAN_MODEL_API_KEY=
# Open model (vision-capable) used for extraction and grounded explanations.
ALAN_MODEL_NAME=qwen/qwen3.8-27b
# Text-only fallback used when the primary open model upstream is unavailable.
ALAN_MODEL_FALLBACKS=nvidia/nemotron-3-super-120b-a12b
ALAN_MODEL_TIMEOUT_SECONDS=90
ALAN_MODEL_MAX_TOKENS=2500
# Optional Alan conversation header for gateway attribution/rate limits.
# Fall back to ALAN_CODE_CONVERSATION_ID when the app runs inside Alan.
ALAN_CONVERSATION_ID=

# ---------------------------------------------------------------------------
# Alan product integration: optional real workflow escalation over MCP
# ---------------------------------------------------------------------------
# This is the documented Alan MCP surface, not an invented SDK.
ALAN_MCP_URL=https://api.tryalan.ai/mcp
# Current Alan MCP authorization header value (usually "Bearer alan_...").
ALAN_MCP_TOKEN=
# The Alan conversation the MCP token is scoped to (shared ALAN_CONVERSATION_ID).
# ID of a private/team Alan automation whose instructions reference
# {{trigger.case_brief}} and {{trigger.question}}. Leave blank to disable
# escalation honestly; the UI will show the missing configuration.
ALAN_WORKFLOW_ID=
ALAN_TIMEOUT_SECONDS=300
ALAN_POLL_SECONDS=3

# ---------------------------------------------------------------------------
# Demo controls
# ---------------------------------------------------------------------------
# Seed the dashboard with the four synthetic samples on first start.
DOCUPILOT_AUTO_SEED=true
DOCUPILOT_MAX_UPLOAD_MB=10
DOCUPILOT_MAX_PDF_PAGES=5
# Set to 1 to force deterministic fixtures and make zero model calls.
DOCUPILOT_DISABLE_MODEL=0
# Optional: override local storage location (defaults to ./var).
# DOCUPILOT_VAR_DIR=./var

# Vite dev server only. Do not put credentials in VITE_* variables; they are
# bundled into the browser.
# VITE_API_BASE=http://127.0.0.1:8000
